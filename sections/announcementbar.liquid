<div class="announcementbar">
    <div class="container">
        <div class="announcement-bar"> 
        <h1>{{ section.settings.message }}</h1>
        </div>

    </div>

</div>

{% schema %}
{
    "name": "Announcement Bar",
    "settings": [
        {
            "type": "text",
            "id": "message",
            "label": "Announcement text",
            "default": "25% OFF for Us based delivery!"
        }
    ]
}
{% endschema %}
